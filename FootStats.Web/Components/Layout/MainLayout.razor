@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Security.Claims
@using FootStats.Web.Models
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<div class="app-shell">
    <div class="topbar">
        <NavMenu />
        <AuthorizeView>
            <Authorized>
                <NavLink href="statistiques" class="topbar-stats-link">
                    <svg viewBox="0 0 24 24" class="icon"><path d="M3 3v18h18"></path><path d="M7 15l4-5 3 3 5-6"></path></svg>
                    <span>Statistiques</span>
                </NavLink>
                <details class="user-menu">
                    <summary class="btn-logout" aria-label="@FullName(context.User)">
                        <span class="avatar">@Initials(context.User)</span>
                        <svg viewBox="0 0 24 24" class="icon chevron"><path d="M6 9l6 6 6-6"></path></svg>
                    </summary>
                    <div class="user-menu-panel">
                        <div class="user-menu-header">
                            <span class="avatar">@Initials(context.User)</span>
                            <div class="user-menu-header-id">
                                <span class="btn-logout-label">@FullName(context.User)</span>
                                <span class="role-pill @RoleCssClass(context.User)">
                                    <svg viewBox="0 0 24 24" class="icon">@((MarkupString)RoleIconPath(context.User))</svg>
                                    @RoleLabel(context.User)
                                </span>
                            </div>
                        </div>
                        <div class="user-menu-divider"></div>
                        <form method="post" action="/account/logout">
                            <button type="submit" class="user-menu-logout">
                                <span class="user-menu-logout-icon">
                                    <svg viewBox="0 0 24 24" class="icon"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg>
                                </span>
                                Se déconnecter
                            </button>
                        </form>
                    </div>
                </details>
            </Authorized>
        </AuthorizeView>
    </div>

    <main>
        @Body
    </main>
</div>

@* Îlot interactif : le layout est rendu en statique (Routes.razor n'a pas de rendermode), donc sans ceci le
   composant vivrait hors du circuit et dans une autre portée DI que les pages, sans jamais recevoir leurs appels. *@
<ConfirmDialog @rendermode="InteractiveServer" />

@code {
    private PeriodicTimer? sessionCheckTimer;

    protected override async Task OnInitializedAsync()
    {
        await CheckSessionStillValidAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            sessionCheckTimer = new PeriodicTimer(TimeSpan.FromSeconds(20));
            _ = PollSessionAsync();
        }
    }

    /// <summary>Tant que ce circuit Blazor Server reste ouvert, revérifie périodiquement que le compte connecté
    /// existe toujours et est actif : coupe la session dès qu'un Admin supprime ou révoque ce compte pendant qu'il
    /// est connecté, plutôt que de laisser planter la prochaine requête de données.</summary>
    private async Task PollSessionAsync()
    {
        try
        {
            while (sessionCheckTimer is not null && await sessionCheckTimer.WaitForNextTickAsync())
            {
                await CheckSessionStillValidAsync();
            }
        }
        catch (ObjectDisposedException) { }
    }

    private async Task CheckSessionStillValidAsync()
    {
        if (!await CurrentUser.IsCurrentSessionValidAsync())
        {
            Navigation.NavigateTo("/account/force-logout", forceLoad: true);
        }
    }

    public ValueTask DisposeAsync()
    {
        sessionCheckTimer?.Dispose();
        sessionCheckTimer = null;
        return ValueTask.CompletedTask;
    }

    private static string Initials(ClaimsPrincipal principal)
    {
        var firstName = principal.FindFirst(ClaimTypes.GivenName)?.Value;
        var lastName = principal.FindFirst(ClaimTypes.Surname)?.Value;

        if (string.IsNullOrEmpty(firstName) && string.IsNullOrEmpty(lastName))
        {
            return principal.Identity?.Name?[..1].ToUpper() ?? "";
        }

        var a = !string.IsNullOrEmpty(firstName) ? firstName[..1] : "";
        var b = !string.IsNullOrEmpty(lastName) ? lastName[..1] : "";
        return (a + b).ToUpper();
    }

    private static string FullName(ClaimsPrincipal principal)
    {
        var firstName = principal.FindFirst(ClaimTypes.GivenName)?.Value;
        var lastName = principal.FindFirst(ClaimTypes.Surname)?.Value;
        var name = $"{firstName} {lastName}".Trim();
        return string.IsNullOrEmpty(name) ? principal.Identity?.Name ?? "" : name;
    }

    private static string RoleLabel(ClaimsPrincipal principal)
    {
        var role = principal.FindFirst(ClaimTypes.Role)?.Value;
        return Enum.TryParse<UserRole>(role, out var parsed)
            ? parsed switch
            {
                UserRole.SuperAdmin => "Super administrateur",
                UserRole.Admin => "Administrateur",
                UserRole.User => "Utilisateur",
                UserRole.Consultant => "Consultant (lecture seule)",
                _ => ""
            }
            : "";
    }

    /// <summary>Couleur de la pastille de rôle dans le menu compte : une teinte par niveau d'accès,
    /// cohérente avec les autres usages de ces couleurs dans l'appli (or = admin, bleu ardoise = système).</summary>
    private static string RoleCssClass(ClaimsPrincipal principal)
    {
        var role = principal.FindFirst(ClaimTypes.Role)?.Value;
        return Enum.TryParse<UserRole>(role, out var parsed)
            ? parsed switch
            {
                UserRole.SuperAdmin => "role-superadmin",
                UserRole.Admin => "role-admin",
                UserRole.User => "role-user",
                UserRole.Consultant => "role-consultant",
                _ => "role-user"
            }
            : "role-user";
    }

    private static string RoleIconPath(ClaimsPrincipal principal)
    {
        var role = principal.FindFirst(ClaimTypes.Role)?.Value;
        if (!Enum.TryParse<UserRole>(role, out var parsed)) return PersonIconPath;
        return parsed switch
        {
            UserRole.SuperAdmin or UserRole.Admin => StarIconPath,
            UserRole.Consultant => EyeIconPath,
            _ => PersonIconPath
        };
    }

    private const string StarIconPath = "<path d=\"M12 2l3 6 6 1-4.5 4 1 6L12 16l-5.5 3 1-6L3 9l6-1z\"></path>";
    private const string PersonIconPath = "<circle cx=\"12\" cy=\"8\" r=\"4\"></circle><path d=\"M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8\"></path>";
    private const string EyeIconPath = "<path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle>";
}
