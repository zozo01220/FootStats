    private async Task AddTrainingOccurrence()
    {
        if (!canManage) return;
        trainingOccurrenceFormError = null;

        if (trainingOccurrenceForm.SeasonId == 0)
        {
            trainingOccurrenceFormError = "Sélectionne l'enfant concerné.";
            return;
        }
        if (string.IsNullOrWhiteSpace(trainingOccurrenceForm.Location))
        {
            trainingOccurrenceFormError = "Indique un lieu.";
            return;
        }
        if (trainingOccurrenceForm.EndTime <= trainingOccurrenceForm.StartTime)
        {
            trainingOccurrenceFormError = "L'heure de fin doit être après l'heure de début.";
            return;
        }

        Db.Trainings.Add(new Training
        {
            SeasonId = trainingOccurrenceForm.SeasonId,
            Days = TrainingOccurrenceHelper.ToMask(trainingOccurrenceForm.Date.DayOfWeek),
            StartTime = trainingOccurrenceForm.StartTime,
            EndTime = trainingOccurrenceForm.EndTime,
            Location = trainingOccurrenceForm.Location.Trim(),
            StartDate = trainingOccurrenceForm.Date,
            EndDate = trainingOccurrenceForm.Date
