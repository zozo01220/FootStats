    private async Task AddTournamentEvent()
    {
        if (!canManage) return;
        tournamentFormError = null;

        if (tournamentForm.SeasonId == 0)
        {
            tournamentFormError = "Sélectionne l'enfant concerné.";
            return;
        }
        if (string.IsNullOrWhiteSpace(tournamentForm.City))
        {
            tournamentFormError = "Indique une ville.";
            return;
        }

        Db.Tournaments.Add(new Tournament
        {
            Name = string.IsNullOrWhiteSpace(tournamentForm.Name) ? null : tournamentForm.Name.Trim(),
            EventType = tournamentForm.EventType,
            City = tournamentForm.City.Trim(),
            Date = DateOnly.FromDateTime(tournamentForm.Date),
            KickoffTime = tournamentForm.KickoffTime,
            TeamNumber = tournamentForm.TeamNumber,
            SeasonId = tournamentForm.SeasonId
        });
        await Db.SaveChangesAsync();
        tournamentCreateModal?.Close();
        await LoadEventsAsync();
    }

