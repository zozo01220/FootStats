@page "/calendrier"
@attribute [Authorize(Roles = "Admin,User,Consultant")]
@rendermode InteractiveServer
@inject CalendarService Calendar
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject AppDbContext Db
@inject ConfirmService Confirm

<PageTitle>Calendrier - FootStats</PageTitle>

<div class="container">
    <div class="page-hero-with-action">
        <PageHero Eyebrow="Club & famille" Title="Calendrier" Subtitle="Tous les matchs, tournois et entraînements, en un coup d'œil." />
        @if (visiblePlayers.Count > 0)
        {
            <button class="btn btn-secondary btn-share-compact" type="button" @onclick="OpenManageTrainings">
                <svg viewBox="0 0 24 24" class="icon"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v10M7 12h10"></path></svg>
                Gérer entraînements
            </button>
        }
    </div>

    @if (visiblePlayers.Count == 0)
    {
        <p class="empty-note">Aucun joueur suivi pour l'instant. <a href="/players" style="color: var(--pitch); font-weight: 600;">Ajoute un joueur</a> pour voir son calendrier ici.</p>
    }
    else
    {
        <div class="cal-toolbar">
            <div class="cal-nav">
                <button class="icon-action" @onclick="GoPrevious" aria-label="Précédent">
                    <svg viewBox="0 0 24 24" class="icon"><path d="M15 6l-6 6 6 6"></path></svg>
                </button>
                <span class="cal-nav-label">@NavLabel()</span>
                <button class="icon-action" @onclick="GoNext" aria-label="Suivant">
                    <svg viewBox="0 0 24 24" class="icon"><path d="M9 6l6 6-6 6"></path></svg>
                </button>
            </div>
            <div class="cal-view-toggle">
                <div class="seg">
                    <button type="button" class="@(view == CalendarViewMode.Month ? "active" : "")" @onclick='() => SetView(CalendarViewMode.Month)'>Mois</button>
                    <button type="button" class="@(view == CalendarViewMode.Week ? "active" : "")" @onclick='() => SetView(CalendarViewMode.Week)'>Semaine</button>
                </div>
            </div>
            <div class="cal-scope">
                @if (visiblePlayers.Count > 1)
                {
                    <label class="dash-player-picker">
                        <span class="dash-player-avatar">
                            <PlayerAvatar Player="visiblePlayers.FirstOrDefault(p => p.Id == selectedPlayerId)">@(selectedPlayerId == 0 ? "T" : PlayerInitials(visiblePlayers.FirstOrDefault(p => p.Id == selectedPlayerId)))</PlayerAvatar>
                        </span>
                        <select @bind="selectedPlayerId" @bind:after="OnPlayerFilterChangedAsync">
                            <option value="0">Tous les joueurs</option>
                            @foreach (var player in visiblePlayers)
                            {
                                <option value="@player.Id">@player.FirstName @player.LastName</option>
                            }
                        </select>
                    </label>
                }
                <button class="btn btn-outline btn-sm" @onclick="GoToday">Aujourd'hui</button>
            </div>
        </div>

        <div class="cal-type-filters">
            <button type="button" class="cal-filter-chip-all @(AllTypesSelected ? "active" : "")" @onclick="SelectAllTypeFilters">Tous</button>
            <button type="button" class="@FilterChipClass(CalendarFilterType.Tournoi)" @onclick="() => ToggleTypeFilter(CalendarFilterType.Tournoi)">
                <span class="event-dot type-tournoi"></span>Tournoi
            </button>
            <button type="button" class="@FilterChipClass(CalendarFilterType.Plateau)" @onclick="() => ToggleTypeFilter(CalendarFilterType.Plateau)">
                <span class="event-dot type-plateau"></span>Plateau
            </button>
            <button type="button" class="@FilterChipClass(CalendarFilterType.Training)" @onclick="() => ToggleTypeFilter(CalendarFilterType.Training)">
                <span class="event-dot type-training"></span>Entraînement
            </button>
        </div>

        @if (view == CalendarViewMode.Month)
        {
            <div class="cal-grid">
                <div class="cal-grid-head">
                    @foreach (var d in TrainingOccurrenceHelper.WeekOrder)
                    {
                        <span>@d.Short</span>
                    }
                </div>
                <div class="cal-grid-body">
                    @foreach (var day in MonthGridDays())
                    {
                        var dayEvents = EventsOn(day);
                        <div class="cal-cell @(day.Month != referenceDate.Month ? "other-month" : "") @(day == Today ? "today" : "")">
                            <div class="cal-day-num">@day.Day</div>
                            @foreach (var e in dayEvents.Take(2))
                            {
                                <div class="cal-chip event-tint @TypeClass(e) @CancelledClasses(e)" @onclick="() => GoToEvent(e)" title="@ChipTitle(e)">
                                    <span class="event-dot @TypeClass(e)"></span>
                                    <span class="club-badge-mini-xs">
                                        @if (!string.IsNullOrEmpty(e.ClubLogoPath))
                                        {
                                            <img src="@e.ClubLogoPath" alt="" />
                                        }
                                        else
                                        {
                                            @((e.ClubName ?? "?")[..1].ToUpper())
                                        }
                                    </span>
                                    <span class="cal-chip-label">@ChipLabel(e)</span>
                                    <span class="cal-chip-cat">@e.Category</span>
                                </div>
                            }
                            @if (dayEvents.Count > 2)
                            {
                                <span class="cal-chip-more" title="@(dayEvents.Count - 2) évènement(s) supplémentaire(s) ce jour-là">+@(dayEvents.Count - 2)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="week-grid">
                @foreach (var day in WeekDays())
                {
                    var dayEvents = EventsOn(day);
                    <div class="week-col @(day == Today ? "today" : "")">
                        <div class="week-col-head">
                            <div class="dow">@TrainingOccurrenceHelper.WeekOrder[((int)day.DayOfWeek + 6) % 7].Short</div>
                            <div class="num">@day.Day</div>
                        </div>
                        <div class="week-col-body">
                            @if (dayEvents.Count == 0)
                            {
                                <div class="week-empty">—</div>
                            }
                            else
                            {
                                @foreach (var e in dayEvents)
                                {
                                    <div class="week-item event-tint @TypeClass(e) @CancelledClasses(e)" @onclick="() => GoToEvent(e)">
                                        <div class="week-item-top">
                                            <span class="club-badge-mini-xs">
                                                @if (!string.IsNullOrEmpty(e.ClubLogoPath))
                                                {
                                                    <img src="@e.ClubLogoPath" alt="" />
                                                }
                                                else
                                                {
                                                    @((e.ClubName ?? "?")[..1].ToUpper())
                                                }
                                            </span>
                                            <div class="title">@ChipLabel(e)</div>
                                            <span class="cal-chip-cat">@e.Category</span>
                                        </div>
                                        <div class="meta">@TimeAndPlayer(e)</div>
                                        @if (e.IsCancelled && e.CancellationReason is { } weekReason)
                                        {
                                            <span class="event-cancel-badge">@TrainingOccurrenceHelper.CancellationReasonLabel(weekReason)</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (canManage)
        {
            <div class="event-fab-wrap">
                @if (showEventMenu)
                {
                    <div class="event-fab-menu">
                        <button type="button" class="event-fab-menu-item" @onclick="() => OpenCreateTournamentEvent(EventType.Tournoi)">
                            <span class="event-fab-menu-icon type-tournoi">
                                <svg viewBox="0 0 24 24" class="icon" style="width:16px;height:16px;"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg>
                            </span>
                            Tournoi
                        </button>
                        <button type="button" class="event-fab-menu-item" @onclick="() => OpenCreateTournamentEvent(EventType.Plateau)">
                            <span class="event-fab-menu-icon type-plateau">
                                <svg viewBox="0 0 24 24" class="icon" style="width:16px;height:16px;"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M8 2v4M16 2v4M3 10h18"></path></svg>
                            </span>
                            Plateau
                        </button>
                        <button type="button" class="event-fab-menu-item" @onclick="OpenCreateTrainingOccurrence">
                            <span class="event-fab-menu-icon type-training">
                                <svg viewBox="0 0 24 24" class="icon" style="width:16px;height:16px;"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v10M7 12h10"></path></svg>
                            </span>
                            <span class="event-fab-menu-label">
                                Séance d'entraînement
                                <span class="event-fab-menu-sub">Une seule date</span>
                            </span>
                        </button>
                        <button type="button" class="event-fab-menu-item" @onclick="OpenCreateTraining">
                            <span class="event-fab-menu-icon type-training">
                                <svg viewBox="0 0 24 24" class="icon" style="width:16px;height:16px;"><path d="M17 2.1l4 4-4 4"></path><path d="M3 12.2v-2a4 4 0 0 1 4-4h14"></path><path d="M7 21.9l-4-4 4-4"></path><path d="M21 11.8v2a4 4 0 0 1-4 4H3"></path></svg>
                            </span>
                            <span class="event-fab-menu-label">
                                Entraînement récurrent
                                <span class="event-fab-menu-sub">Chaque semaine, sur une période</span>
                            </span>
                        </button>
                    </div>
                }
                <button type="button" class="event-fab" @onclick="ToggleEventMenu" aria-label="Ajouter">
                    <svg viewBox="0 0 24 24" class="icon" style="@(showEventMenu ? "transform: rotate(45deg);" : "")"><path d="M12 5v14M5 12h14"></path></svg>
                </button>
            </div>
        }
    }

    <Modal @ref="tournamentCreateModal" Label="Nouvel événement">
        <ChildContent>
            <EditForm Model="tournamentForm" OnValidSubmit="AddTournamentEvent">
                <div class="field" style="margin-bottom: 16px;">
                    <label>Équipe</label>
                    <select @bind="tournamentForm.TeamNumber">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">Équipe @i</option>
                        }
                    </select>
                </div>
                @if (NonEquitationSeasons.Count > 1)
                {
                    <div class="field" style="margin-bottom: 16px;">
                        <label>Enfant</label>
                        <select @bind="tournamentForm.SeasonId">
                            @foreach (var s in NonEquitationSeasons)
                            {
                                <option value="@s.Id">@s.Player?.FirstName @s.Player?.LastName — @s.Club?.Name (@s.Label)@(s.IsArchived ? " · archivée" : "")</option>
                            }
                        </select>
                    </div>
                }
                <div class="field" style="margin-bottom: 16px;">
                    <label>Nom (optionnel)</label>
                    <input @bind="tournamentForm.Name" placeholder="Pas de nom pour un plateau" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>Ville</label>
                    <input @bind="tournamentForm.City" />
                </div>
                <div class="form-row cols-3" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
                    <div class="field" style="margin-bottom: 0;"><label>Date</label><input type="date" @bind="tournamentForm.Date" /></div>
                    <div class="field" style="margin-bottom: 0;"><label>Coup d'envoi (optionnel)</label><input type="time" @bind="tournamentForm.KickoffTime" /></div>
                </div>
                @if (tournamentFormError is not null)
                {
                    <p class="empty-note" style="color: var(--danger); padding: 0 0 8px;">@tournamentFormError</p>
                }
                <button class="btn btn-primary" type="submit">Ajouter</button>
            </EditForm>
        </ChildContent>
    </Modal>

    <Modal @ref="trainingOccurrenceCreateModal" Label="Nouvel entraînement">
        <ChildContent>
            <EditForm Model="trainingOccurrenceForm" OnValidSubmit="AddTrainingOccurrence">
                @if (availableSeasons.Count > 1)
                {
                    <div class="field" style="margin-bottom: 16px;">
                        <label>Enfant</label>
                        <select @bind="trainingOccurrenceForm.SeasonId">
                            @foreach (var s in availableSeasons)
                            {
                                <option value="@s.Id">@s.Player?.FirstName @s.Player?.LastName — @s.Club?.Name (@s.Label)</option>
                            }
                        </select>
                    </div>
                }
                <div class="form-row cols-3" style="grid-template-columns: 1fr 1fr 1fr; margin-bottom: 16px;">
                    <div class="field" style="margin-bottom: 0;"><label>Date</label><input type="date" @bind="trainingOccurrenceForm.Date" /></div>
                    <div class="field" style="margin-bottom: 0;"><label>Heure de début</label><input type="time" @bind="trainingOccurrenceForm.StartTime" /></div>
                    <div class="field" style="margin-bottom: 0;"><label>Heure de fin</label><input type="time" @bind="trainingOccurrenceForm.EndTime" /></div>
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>Lieu</label>
                    <input @bind="trainingOccurrenceForm.Location" placeholder="Stade Municipal" />
                </div>
                @if (trainingOccurrenceFormError is not null)
                {
                    <p class="empty-note" style="color: var(--danger); padding: 0 0 8px;">@trainingOccurrenceFormError</p>
                }
                <button class="btn btn-primary" type="submit">Ajouter</button>
            </EditForm>
        </ChildContent>
    </Modal>

    <Modal @ref="trainingQuickModal" Label="@(quickEditEvent is null ? "Entraînement" : $"Entraînement — {DayLabel(quickEditEvent.Date)}")">
        <Subtitle>
            @if (quickEditEvent is not null)
            {
                <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">
                    <strong style="color: var(--ink);">@quickEditEvent.PlayerName</strong> &middot; @(quickEditEvent.ClubName ?? "Club inconnu") &middot; @quickEditEvent.Category
                </div>
            }
        </Subtitle>
        <ChildContent>
            @if (quickEditEvent is not null && quickEditEvent.IsCancelled)
            {
                <div class="cancel-reason-box">
                    <div class="cancel-reason-title">
                        <svg viewBox="0 0 24 24" class="icon" style="width:14px;height:14px;"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
                        Séance annulée
                    </div>
                    @if (quickEditEvent.CancellationReason is { } currentReason)
                    {
                        var currentReasonInfo = TrainingOccurrenceHelper.CancellationReasons.First(r => r.Value == currentReason);
                        <div class="cancel-reason-opt @currentReasonInfo.CssClass selected">
                            <span class="cancel-reason-radio"><span class="dot"></span></span>
                            <span class="cancel-reason-sw"></span>
                            <span>
                                <span class="cancel-reason-label">@currentReasonInfo.Label</span>
                                <span class="cancel-reason-desc">@currentReasonInfo.Description</span>
                            </span>
                        </div>
                    }
                    <div class="cancel-reason-actions">
                        <button type="button" class="btn btn-primary" @onclick="ReactivateTrainingFromQuickEdit">Réactiver cette séance</button>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="quickForm" OnValidSubmit="SaveTrainingQuickEdit">
                    <div class="form-row cols-3" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
                        <div class="field" style="margin-bottom: 0;"><label>Heure de début</label><input type="time" @bind="quickForm.StartTime" /></div>
                        <div class="field" style="margin-bottom: 0;"><label>Heure de fin</label><input type="time" @bind="quickForm.EndTime" /></div>
                    </div>
                    <div class="field" style="margin-bottom: 16px;">
                        <label>Lieu</label>
                        <input @bind="quickForm.Location" />
                    </div>
                    @if (editingTraining is not null)
                    {
                        <p class="empty-note" style="padding: 0 0 16px; display: flex; align-items: center; gap: 6px;">
                            <svg viewBox="0 0 24 24" class="icon" style="width:13px;height:13px;"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v10M7 12h10"></path></svg>
                            Ce changement ne concerne que cette séance. Récurrence (@TrainingOccurrenceHelper.DaysLabel(editingTraining.Days).ToLower()) et période : à modifier depuis "Gérer entraînements".
                        </p>
                    }
                    @if (quickFormError is not null)
                    {
                        <p class="empty-note" style="color: var(--danger); padding: 0 0 8px;">@quickFormError</p>
                    }
                    @if (!showCancelReasonPicker && quickEditEvent is not null && quickEditEvent.Date <= Today)
                    {
                        <div class="cancel-reason-box">
                            <div class="cancel-reason-title">
                                <svg viewBox="0 0 24 24" class="icon" style="width:14px;height:14px;"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path><path d="m8.5 15 2 2 4.5-4.5"></path></svg>
                                Présence
                            </div>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                <button type="button" class="attendance-pick present @(quickEditEvent.AttendanceStatus == AttendanceStatus.Present ? "selected" : "")" @onclick="() => ToggleAttendance(AttendanceStatus.Present)">Présent</button>
                                <button type="button" class="attendance-pick excused @(quickEditEvent.AttendanceStatus == AttendanceStatus.Excused ? "selected" : "")" @onclick="() => ToggleAttendance(AttendanceStatus.Excused)">Excusé</button>
                                <button type="button" class="attendance-pick absent @(quickEditEvent.AttendanceStatus == AttendanceStatus.Absent ? "selected" : "")" @onclick="() => ToggleAttendance(AttendanceStatus.Absent)">Absent</button>
                            </div>
                        </div>
                    }
                    @if (showCancelReasonPicker)
                    {
                        <div class="cancel-reason-box">
                            <div class="cancel-reason-title">
                                <svg viewBox="0 0 24 24" class="icon" style="width:14px;height:14px;"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
                                Motif de l'annulation
                            </div>
                            <div class="cancel-reason-opts">
                                @foreach (var reason in TrainingOccurrenceHelper.CancellationReasons)
                                {
                                    <button type="button" class="cancel-reason-opt @reason.CssClass @(selectedCancelReason == reason.Value ? "selected" : "")" @onclick="() => selectedCancelReason = reason.Value">
                                        <span class="cancel-reason-radio"><span class="dot"></span></span>
                                        <span class="cancel-reason-sw"></span>
                                        <span>
                                            <span class="cancel-reason-label">@reason.Label</span>
                                            <span class="cancel-reason-desc">@reason.Description</span>
                                        </span>
                                    </button>
                                }
                            </div>
                            @if (cancelReasonError is not null)
                            {
                                <p class="empty-note" style="color: var(--danger); padding: 8px 0 0;">@cancelReasonError</p>
                            }
                            <div class="cancel-reason-actions">
                                <button type="button" class="btn btn-outline btn-sm" @onclick="CloseCancelReasonPicker">Retour</button>
                                <button type="button" class="btn-danger-outline" @onclick="ConfirmCancelTrainingFromQuickEdit">Confirmer l'annulation</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                            <button type="button" class="btn-danger-outline" @onclick="OpenCancelReasonPicker">Annuler cette séance</button>
                            <button class="btn btn-primary" type="submit">Enregistrer</button>
                        </div>
                    }
                </EditForm>
            }
        </ChildContent>
    </Modal>

    <Modal @ref="trainingCreateModal" Label="Nouvel entraînement récurrent">
        <ChildContent>
            <EditForm Model="trainingForm" OnValidSubmit="AddTraining">
                @if (availableSeasons.Count > 1)
                {
                    <div class="field" style="margin-bottom: 16px;">
                        <label>Enfant</label>
                        <select @bind="trainingForm.SeasonId">
                            @foreach (var s in availableSeasons)
                            {
                                <option value="@s.Id">@s.Player?.FirstName @s.Player?.LastName — @s.Club?.Name (@s.Label)</option>
                            }
                        </select>
                    </div>
                }
                @TrainingFields(trainingForm)
                @if (trainingFormError is not null)
                {
                    <p class="empty-note" style="color: var(--danger); padding: 0 0 8px;">@trainingFormError</p>
                }
                <button class="btn btn-primary" type="submit">Ajouter</button>
            </EditForm>
        </ChildContent>
    </Modal>

    <Modal @ref="trainingEditModal" Label="Modifier l'entraînement récurrent">
        <ChildContent>
            <EditForm Model="trainingEditForm" OnValidSubmit="SaveEditTraining">
                @TrainingFields(trainingEditForm)
                @if (trainingFormError is not null)
                {
                    <p class="empty-note" style="color: var(--danger); padding: 0 0 8px;">@trainingFormError</p>
                }
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            </EditForm>
        </ChildContent>
    </Modal>

    <Modal @ref="trainingManageModal" Label="Entraînements récurrents">
        <Subtitle>
            <span class="pill pill-gold" style="margin-left: 8px;">@trainings.Count</span>
        </Subtitle>
        <ChildContent>
            @if (trainings.Count == 0)
            {
                <p class="empty-note" style="padding: 0 0 4px;">Aucun entraînement récurrent pour le moment.</p>
            }
            else
            {
                @foreach (var t in trainings)
                {
                    <div class="training-rule-row">
                        <div class="training-rule-line1">
                            <div class="training-days">
                                @foreach (var d in TrainingOccurrenceHelper.WeekOrder)
                                {
                                    <span class="training-day-pip @(t.Days.HasFlag(d.Mask) ? "on" : "off")">@d.Short[..1]</span>
                                }
                            </div>
                            @if (canManage)
                            {
                                <div class="row-actions">
                                    <button class="icon-action" @onclick="() => OpenEditTraining(t)" aria-label="Modifier" title="Modifier">
                                        <svg viewBox="0 0 24 24" class="icon"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
                                    </button>
                                    <button class="icon-action delete" @onclick="() => DeleteTraining(t.Id)" aria-label="Supprimer" title="Supprimer">
                                        <svg viewBox="0 0 24 24" class="icon"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path></svg>
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="training-rule-line2">
                            @TrainingOccurrenceHelper.DaysLabel(t.Days), @t.StartTime.ToString("HH:mm") – @t.EndTime.ToString("HH:mm")
                            @if (visiblePlayers.Count > 1)
                            {
                                <span class="pill">@t.Season?.Player?.FirstName @t.Season?.Player?.LastName</span>
                            }
                            @if (!string.IsNullOrEmpty(t.Season?.Category))
                            {
                                <span class="pill pill-gold" title="Catégorie de la saison liée à cette règle">@t.Season.Category</span>
                            }
                        </div>
                        <div class="training-rule-line3">
                            <svg viewBox="0 0 24 24" class="icon"><path d="M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>
                            @t.Location &middot; du @t.StartDate.ToString("dd.MM.yy")@(t.EndDate is { } end ? $" au {end:dd.MM.yy}" : "")
                        </div>
                    </div>
                }
            }
        </ChildContent>
    </Modal>
</div>

@code {
    private enum CalendarViewMode { Month, Week }
    private enum CalendarFilterType { Tournoi, Plateau, Training }

    private CalendarViewMode view = CalendarViewMode.Month;
    private DateOnly referenceDate = DateOnly.FromDateTime(DateTime.Today);
    private List<Player> visiblePlayers = [];
    private int selectedPlayerId;
    private List<CalendarEvent> events = [];
    private bool canManage;

    // Filtre par type d'événement (Tournoi/Plateau/Entraînement), affiché en PC comme en mobile.
