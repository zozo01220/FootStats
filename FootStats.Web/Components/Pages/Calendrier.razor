    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        visiblePlayers = await (await CurrentUser.GetVisiblePlayersAsync()).OrderBy(p => p.FirstName).ToListAsync();
        canManage = await CurrentUser.CanManageFamilyDataAsync();
        await LoadEventsAsync();
        await LoadTrainingsAsync();
    }

    private async Task OnPlayerFilterChangedAsync()
    {
        await LoadEventsAsync();
        await LoadTrainingsAsync();
    }

    private async Task SetView(CalendarViewMode mode)
    {
        view = mode;
        await LoadEventsAsync();
    }

    private async Task GoPrevious()
    {
        referenceDate = view == CalendarViewMode.Month ? referenceDate.AddMonths(-1) : referenceDate.AddDays(-7);
        await LoadEventsAsync();
    }

    private async Task GoNext()
    {
        referenceDate = view == CalendarViewMode.Month ? referenceDate.AddMonths(1) : referenceDate.AddDays(7);
        await LoadEventsAsync();
    }

    private async Task GoToday()
    {
        referenceDate = Today;
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        var (from, to) = RangeFor(view, referenceDate);
        var all = await Calendar.GetEventsAsync(from, to);
        events = selectedPlayerId == 0 ? all : all.Where(e => e.PlayerId == selectedPlayerId).ToList();
    }

    private async Task LoadTrainingsAsync()
    {
        var playerIds = visiblePlayers.Select(p => p.Id).ToHashSet();

        var query = Db.Trainings
            .Include(t => t.Season).ThenInclude(s => s!.Player)
            .Include(t => t.Season).ThenInclude(s => s!.Club)
            .Where(t => playerIds.Contains(t.Season!.PlayerId));
        if (selectedPlayerId != 0) query = query.Where(t => t.Season!.PlayerId == selectedPlayerId);
        trainings = await query.OrderBy(t => t.Season!.Player!.FirstName).ThenBy(t => t.StartDate).ToListAsync();

        var seasons = await Db.Seasons
            .Include(s => s.Player)
            .Include(s => s.Club)
            .Where(s => playerIds.Contains(s.PlayerId))
            .OrderBy(s => s.Player!.FirstName)
            .ToListAsync();
        availableSeasons = seasons.Where(s => !s.IsArchived).ToList();
        // Une saison archivée reste sélectionnable pour rattacher un événement passé (ex. un tournoi
        // oublié de la saison précédente) : seuls les entraînements (récurrents ou ponctuels), tournés vers
        // l'avenir, se limitent aux saisons actives via availableSeasons.
        allSeasonsIncludingArchived = seasons;
    }

    private static (DateOnly From, DateOnly To) RangeFor(CalendarViewMode mode, DateOnly reference) => mode switch
    {
        CalendarViewMode.Month => (GridStart(reference), GridStart(reference).AddDays(41)),
        _ => (WeekStart(reference), WeekStart(reference).AddDays(6))
    };

    private static DateOnly GridStart(DateOnly reference)
    {
        var firstOfMonth = new DateOnly(reference.Year, reference.Month, 1);
        var offset = ((int)firstOfMonth.DayOfWeek + 6) % 7;
        return firstOfMonth.AddDays(-offset);
    }

    private static DateOnly WeekStart(DateOnly reference)
    {
        var offset = ((int)reference.DayOfWeek + 6) % 7;
        return reference.AddDays(-offset);
    }

    private IEnumerable<DateOnly> MonthGridDays()
    {
        var start = GridStart(referenceDate);
        for (var i = 0; i < 42; i++) yield return start.AddDays(i);
    }

    private IEnumerable<DateOnly> WeekDays()
    {
        var start = WeekStart(referenceDate);
        for (var i = 0; i < 7; i++) yield return start.AddDays(i);
    }

    private List<CalendarEvent> EventsOn(DateOnly day) => FilteredEvents.Where(e => e.Date == day).ToList();

    private string NavLabel() => view == CalendarViewMode.Week
        ? $"{WeekStart(referenceDate):dd.MM} – {WeekStart(referenceDate).AddDays(6):dd.MM.yyyy}"
        : $"{MonthName(referenceDate.Month)} {referenceDate.Year}";

    private async Task GoToEvent(CalendarEvent e)
    {
        if (e.Kind == CalendarEventKind.Training)
        {
            if (canManage) await OpenTrainingQuickEdit(e);
            return;
        }
        GoToTournamentDetail(e.TournamentId);
    }

    private void GoToTournamentDetail(int? tournamentId) => Navigation.NavigateTo($"/tournaments/{tournamentId}");

    private async Task OpenTrainingQuickEdit(CalendarEvent e)
    {
        if (e.TrainingId is not { } trainingId) return;
        editingTraining = await Db.Trainings.FindAsync(trainingId);
        if (editingTraining is null) return;

        quickEditEvent = e;
        quickFormError = null;
        quickForm = new TrainingQuickForm
        {
            // e.StartTime/EndTime/Location reflètent déjà l'éventuelle exception de cette date précise
            // (CalendarService applique l'override sur l'occurrence avant de construire l'événement).
            StartTime = e.StartTime ?? editingTraining.StartTime,
            EndTime = e.EndTime ?? editingTraining.EndTime,
            Location = e.Location
        };
        showCancelReasonPicker = false;
        selectedCancelReason = null;
        cancelReasonError = null;
        trainingQuickModal?.Open();
    }

    private void OpenCancelReasonPicker()
    {
        showCancelReasonPicker = true;
        selectedCancelReason = null;
        cancelReasonError = null;
    }

    private void CloseCancelReasonPicker()
    {
        showCancelReasonPicker = false;
        selectedCancelReason = null;
        cancelReasonError = null;
    }

    /// <summary>Récupère (ou crée) l'exception ponctuelle pour cette date précise d'une règle récurrente —
    /// jamais la règle elle-même, pour que l'action ne touche que cette occurrence.</summary>
    private async Task<TrainingOccurrenceOverride> GetOrCreateOccurrenceOverrideAsync(int trainingId, DateOnly date)
    {
        var existing = await Db.TrainingOccurrenceOverrides
            .FirstOrDefaultAsync(o => o.TrainingId == trainingId && o.Date == date);
        if (existing is not null) return existing;

        var created = new TrainingOccurrenceOverride { TrainingId = trainingId, Date = date };
        Db.TrainingOccurrenceOverrides.Add(created);
        return created;
    }

    private async Task SaveTrainingQuickEdit()
    {
        if (editingTraining is null || quickEditEvent is null) return;
        quickFormError = null;

        if (string.IsNullOrWhiteSpace(quickForm.Location))
        {
            quickFormError = "Indique un lieu.";
            return;
        }
        if (quickForm.EndTime <= quickForm.StartTime)
        {
            quickFormError = "L'heure de fin doit être après l'heure de début.";
            return;
        }

        var occurrenceOverride = await GetOrCreateOccurrenceOverrideAsync(editingTraining.Id, quickEditEvent.Date);
        occurrenceOverride.IsCancelled = false;
        occurrenceOverride.CancellationReason = null;
        occurrenceOverride.StartTime = quickForm.StartTime;
        occurrenceOverride.EndTime = quickForm.EndTime;
        occurrenceOverride.Location = quickForm.Location.Trim();
        await Db.SaveChangesAsync();
        trainingQuickModal?.Close();
        await LoadEventsAsync();
    }

    private async Task ConfirmCancelTrainingFromQuickEdit()
    {
        if (editingTraining is null || quickEditEvent is null) return;
        if (selectedCancelReason is null)
        {
            cancelReasonError = "Choisis un motif.";
            return;
        }
        cancelReasonError = null;

        var occurrenceOverride = await GetOrCreateOccurrenceOverrideAsync(editingTraining.Id, quickEditEvent.Date);
        occurrenceOverride.IsCancelled = true;
        occurrenceOverride.CancellationReason = selectedCancelReason;
        await Db.SaveChangesAsync();
        trainingQuickModal?.Close();
        showCancelReasonPicker = false;
        selectedCancelReason = null;
        editingTraining = null;
        quickEditEvent = null;
        await LoadEventsAsync();
    }

    private async Task ReactivateTrainingFromQuickEdit()
    {
        if (editingTraining is null || quickEditEvent is null) return;

        var occurrenceOverride = await GetOrCreateOccurrenceOverrideAsync(editingTraining.Id, quickEditEvent.Date);
        occurrenceOverride.IsCancelled = false;
        occurrenceOverride.CancellationReason = null;
        await Db.SaveChangesAsync();
        trainingQuickModal?.Close();
        editingTraining = null;
        quickEditEvent = null;
        await LoadEventsAsync();
    }

    private async Task ToggleAttendance(AttendanceStatus status)
    {
        if (!canManage || quickEditEvent is null || quickEditEvent.TrainingId is not { } trainingId) return;

        var existing = await Db.TrainingAttendances.FirstOrDefaultAsync(a => a.TrainingId == trainingId && a.Date == quickEditEvent.Date);
        if (existing is not null && existing.Status == status)
        {
            Db.TrainingAttendances.Remove(existing);
            quickEditEvent.AttendanceStatus = null;
        }
        else if (existing is not null)
        {
            existing.Status = status;
            quickEditEvent.AttendanceStatus = status;
        }
        else
        {
            Db.TrainingAttendances.Add(new TrainingAttendance { TrainingId = trainingId, Date = quickEditEvent.Date, Status = status });
            quickEditEvent.AttendanceStatus = status;
        }
        await Db.SaveChangesAsync();

        var listed = events.FirstOrDefault(ev => ev.TrainingId == trainingId && ev.Date == quickEditEvent.Date);
        if (listed is not null) listed.AttendanceStatus = quickEditEvent.AttendanceStatus;
    }

