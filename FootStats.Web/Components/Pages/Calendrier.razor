        await Db.SaveChangesAsync();
        trainingOccurrenceCreateModal?.Close();
        await LoadTrainingsAsync();
        await LoadEventsAsync();
    }

    private async Task AddTraining()
    {
        if (!canManage) return;
        trainingFormError = null;

        if (trainingForm.SeasonId == 0)
        {
            trainingFormError = "Sélectionne l'enfant concerné.";
            return;
        }
        if (trainingForm.Days.Count == 0)
        {
            trainingFormError = "Sélectionne au moins un jour de la semaine.";
            return;
        }
        if (string.IsNullOrWhiteSpace(trainingForm.Location))
        {
            trainingFormError = "Indique un lieu.";
            return;
        }
        if (trainingForm.EndTime <= trainingForm.StartTime)
        {
            trainingFormError = "L'heure de fin doit être après l'heure de début.";
            return;
        }

        Db.Trainings.Add(new Training
        {
            SeasonId = trainingForm.SeasonId,
            Days = trainingForm.Days.Aggregate(DaysOfWeekMask.None, (acc, d) => acc | d),
            StartTime = trainingForm.StartTime,
            EndTime = trainingForm.EndTime,
            Location = trainingForm.Location.Trim(),
            StartDate = trainingForm.StartDate,
            EndDate = trainingForm.EndDate
        });
        await Db.SaveChangesAsync();
        trainingCreateModal?.Close();
        await LoadTrainingsAsync();
        await LoadEventsAsync();
    }

    private void OpenEditTraining(Training t)
    {
        if (!canManage) return;
        trainingFormError = null;
        editingTrainingId = t.Id;
        trainingEditForm = new TrainingForm
        {
            SeasonId = t.SeasonId,
            Days = TrainingOccurrenceHelper.WeekOrder.Where(d => t.Days.HasFlag(d.Mask)).Select(d => d.Mask).ToHashSet(),
            StartTime = t.StartTime,
            EndTime = t.EndTime,
            Location = t.Location,
            StartDate = t.StartDate,
            EndDate = t.EndDate
        };
        trainingEditModal?.Open();
    }

    private async Task SaveEditTraining()
    {
        if (!canManage) return;
        trainingFormError = null;

        if (trainingEditForm.Days.Count == 0)
        {
            trainingFormError = "Sélectionne au moins un jour de la semaine.";
            return;
        }
        if (string.IsNullOrWhiteSpace(trainingEditForm.Location))
        {
            trainingFormError = "Indique un lieu.";
            return;
        }
        if (trainingEditForm.EndTime <= trainingEditForm.StartTime)
        {
            trainingFormError = "L'heure de fin doit être après l'heure de début.";
            return;
        }

        var training = await Db.Trainings.FindAsync(editingTrainingId);
        if (training is null) return;

        training.Days = trainingEditForm.Days.Aggregate(DaysOfWeekMask.None, (acc, d) => acc | d);
        training.StartTime = trainingEditForm.StartTime;
        training.EndTime = trainingEditForm.EndTime;
        training.Location = trainingEditForm.Location.Trim();
        training.StartDate = trainingEditForm.StartDate;
        training.EndDate = trainingEditForm.EndDate;

        await Db.SaveChangesAsync();
        trainingEditModal?.Close();
        await LoadTrainingsAsync();
        await LoadEventsAsync();
    }

    private async Task DeleteTraining(int trainingId)
    {
        if (!canManage) return;
        var training = await Db.Trainings.FindAsync(trainingId);
        if (training is null) return;

        if (!await Confirm.AskAsync(new ConfirmRequest
        {
            Title = "Supprimer l'entraînement",
            Message = "Toutes les séances de cette récurrence disparaîtront du calendrier, y compris les présences déjà pointées.",
            ConfirmLabel = "Supprimer",
            Tone = ConfirmTone.Danger,
            Icon = ConfirmIcon.Trash,
            SubjectName = TrainingOccurrenceHelper.DaysLabel(training.Days),
            SubjectMeta = $"{training.StartTime:HH:mm} – {training.EndTime:HH:mm} · {training.Location}",
            SubjectInitials = "EN"
        })) return;

        Db.Trainings.Remove(training);
        await Db.SaveChangesAsync();
        await LoadTrainingsAsync();
        await LoadEventsAsync();
    }

    private void ToggleDay(TrainingForm form, DaysOfWeekMask day)
    {
        if (!form.Days.Remove(day)) form.Days.Add(day);
    }

    private RenderFragment TrainingFields(TrainingForm targetForm) => @<div>
        <div class="field" style="margin-bottom: 16px;">
            <label>Jours de la semaine</label>
            <div class="day-toggle-row">
                @foreach (var d in TrainingOccurrenceHelper.WeekOrder)
                {
                    <button type="button" class="day-toggle @(targetForm.Days.Contains(d.Mask) ? "on" : "")" @onclick="() => ToggleDay(targetForm, d.Mask)">@d.Short</button>
                }
            </div>
        </div>
        <div class="form-row cols-3" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
            <div class="field" style="margin-bottom: 0;"><label>Heure de début</label><input type="time" @bind="targetForm.StartTime" /></div>
            <div class="field" style="margin-bottom: 0;"><label>Heure de fin</label><input type="time" @bind="targetForm.EndTime" /></div>
        </div>
        <div class="field" style="margin-bottom: 16px;">
            <label>Lieu</label>
            <input @bind="targetForm.Location" placeholder="Stade Municipal" />
        </div>
        <div class="form-row cols-3" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
            <div class="field" style="margin-bottom: 0;"><label>Du</label><input type="date" @bind="targetForm.StartDate" /></div>
            <div class="field" style="margin-bottom: 0;"><label>Au (optionnel)</label><input type="date" @bind="targetForm.EndDate" /></div>
        </div>
    </div>;

    private static string TypeClass(CalendarEvent e) => e.Kind switch
    {
        CalendarEventKind.Training => "type-training",
        _ => e.EventType == EventType.Tournoi ? "type-tournoi" : "type-plateau"
    };

    private static string CancelledClasses(CalendarEvent e) => e.IsCancelled
        ? $"event-cancelled {(e.CancellationReason is { } r ? TrainingOccurrenceHelper.CancellationReasonCssClass(r) : "")}"
        : "";

    private static string ChipLabel(CalendarEvent e) => e.Kind == CalendarEventKind.Training ? "Entraînement" : e.Title;

    private static string ChipTitle(CalendarEvent e)
    {
        var label = e.StartTime is { } t ? $"{ChipLabel(e)} · {t:HH:mm} · {e.PlayerName}" : $"{ChipLabel(e)} · {e.PlayerName}";
        return e.IsCancelled && e.CancellationReason is { } reason
            ? $"{label} · {TrainingOccurrenceHelper.CancellationReasonLabel(reason)}"
            : label;
    }

    private static string TimeAndPlayer(CalendarEvent e)
    {
        var parts = new List<string>();
        if (e.StartTime is { } start) parts.Add(e.EndTime is { } end ? $"{start:HH:mm} – {end:HH:mm}" : $"{start:HH:mm}");
        parts.Add(e.PlayerName);
        parts.Add(e.Location);
        return string.Join(" · ", parts);
    }

    private static string PlayerInitials(Player? player)
    {
        if (player is null) return "?";
        var a = player.FirstName.Length > 0 ? player.FirstName[0].ToString() : "";
        var b = player.LastName.Length > 0 ? player.LastName[0].ToString() : "";
        return (a + b).ToUpper();
    }

    private static readonly string[] MonthNames =
        ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
    private static string MonthName(int month) => MonthNames[month - 1];

    private static readonly string[] DayNames = ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"];
    private static string DayLabel(DateOnly date) => $"{DayNames[((int)date.DayOfWeek + 6) % 7]} {date.Day} {MonthName(date.Month).ToLower()}";

