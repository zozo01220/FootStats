@page "/rejoindre/{Token}"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout
@rendermode InteractiveServer
@inject ShareInviteService ShareInviteSvc
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Rejoindre FootStats</PageTitle>

<div class="login-shell">
    <div class="login-pitch">
        <div class="login-glow" aria-hidden="true"></div>
        <div class="login-eyebrow">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--gold);"></div>
            <span>@(invite?.Role == UserRole.Consultant ? "Invitation à consulter" : "Invitation à gérer")</span>
        </div>
        <div class="login-titleblock">
            <h1 class="login-title">
                FOOT<span style="color: var(--gold);">STATS</span>
            </h1>
            <div class="login-subtitle">Gratuit, en moins d'une minute.</div>
        </div>
    </div>

    <div class="login-form-side">
        <div class="card login-card">
            <div class="login-card-handle" aria-hidden="true"></div>

            @if (invalidReason is not null)
            {
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <h1 style="font-size: 26px;">Lien invalide</h1>
                    <div class="alert alert-danger">@invalidReason</div>
                    <p class="empty-note">Demandez à la personne qui vous l'a envoyé de vous partager un nouveau lien.</p>
                </div>
            }
            else
            {
                <p style="font-size: 14px; line-height: 1.55; margin: 0 0 18px;">
                    <strong>@adminName</strong> vous invite à <strong>@(invite!.Role == UserRole.Consultant ? "consulter les statistiques" : "gérer le suivi")</strong> de <strong>@playerNames</strong> sur FootStats.
                </p>

                <AuthorizeView Context="authState">
                    <Authorized>
                        @if (attachSuccess)
                        {
                            <div class="alert alert-success" style="margin-bottom: 12px;">Accès ajouté avec succès !</div>
                            <a class="btn btn-primary btn-block" href="/">Aller sur FootStats</a>
                        }
                        else
                        {
                            @if (attachError is not null)
                            {
                                <div class="alert alert-danger" style="margin-bottom: 12px;">@attachError</div>
                            }
                            <div style="background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                                <div style="width: 38px; height: 38px; border-radius: 999px; background: var(--pitch-dark); color: var(--gold); font-weight: 800; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    @Initials(authState.User.Identity?.Name)
                                </div>
                                <div>
                                    <div style="font-size: 11.5px; color: var(--muted);">Connecté en tant que</div>
                                    <div style="font-weight: 800; font-size: 14px;">@authState.User.Identity?.Name</div>
                                </div>
                            </div>
                            <button class="btn btn-primary btn-block" type="button" disabled="@attaching" @onclick="AttachToCurrentUser">
                                @(attaching ? "..." : "Ajouter cet accès à mon compte")
                            </button>
                            <form method="post" action="@($"/account/logout?returnUrl=/rejoindre/{Token}")" style="text-align: center; margin-top: 14px;">
                                <button type="submit" class="foot-link" style="background: none; border: none; color: var(--muted); font-size: 12.5px; font-weight: 600; text-decoration: underline; cursor: pointer;">
                                    Ce n'est pas vous ? Se déconnecter
                                </button>
                            </form>
                        }
                    </Authorized>
                    <NotAuthorized>
                        @if (formError is not null)
                        {
                            <div class="alert alert-danger">@formError</div>
                        }
                        @if (GoogleEnabled || MicrosoftEnabled)
                        {
                            <div class="oauth-buttons">
                                @if (GoogleEnabled)
                                {
                                    <a class="btn-oauth" href="@($"/account/external-login/Google?returnUrl={Uri.EscapeDataString($"/rejoindre/{Token}")}")">
                                        <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.6 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.68-3.87 2.68-6.62z"></path><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.96v2.33A9 9 0 0 0 9 18z"></path><path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.03l2.99-2.33z"></path><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.42 0 9 0A9 9 0 0 0 .96 4.97L3.95 7.3C4.66 5.17 6.65 3.58 9 3.58z"></path></svg>
                                        Continuer avec Google
                                    </a>
                                }
                                @if (MicrosoftEnabled)
                                {
                                    <a class="btn-oauth" href="@($"/account/external-login/Microsoft?returnUrl={Uri.EscapeDataString($"/rejoindre/{Token}")}")">
                                        <svg width="16" height="16" viewBox="0 0 16 16"><rect width="7" height="7" x="0" y="0" fill="#F25022"></rect><rect width="7" height="7" x="9" y="0" fill="#7FBA00"></rect><rect width="7" height="7" x="0" y="9" fill="#00A4EF"></rect><rect width="7" height="7" x="9" y="9" fill="#FFB900"></rect></svg>
                                        Continuer avec Microsoft
                                    </a>
                                }
                            </div>
                            <div class="oauth-divider">ou avec un e-mail</div>
                        }
                        <EditForm Model="this" OnValidSubmit="Submit" style="display: flex; flex-direction: column; gap: 10px;">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div class="field">
                                    <label>Prénom</label>
                                    <input @bind="firstName" />
                                </div>
                                <div class="field">
                                    <label>Nom</label>
                                    <input @bind="lastName" />
                                </div>
                            </div>
                            <div class="field">
                                <label>Email (optionnel)</label>
                                <input type="email" @bind="email" />
                            </div>
                            <div class="field">
                                <label>Mot de passe</label>
                                <PasswordField @bind-Value="password" Required="true" />
                            </div>
                            <div class="field">
                                <label>Confirmer le mot de passe</label>
                                <PasswordField @bind-Value="passwordConfirm" Required="true" />
                            </div>
                            <button class="btn btn-primary btn-block" type="submit" disabled="@submitting" style="margin-top: 2px;">
                                @(submitting ? "Création..." : "Créer mon compte")
                            </button>
                        </EditForm>
                        <div style="text-align: center; font-size: 13px; color: var(--muted); margin-top: 12px;">
                            Déjà un compte FootStats ? <a href="@($"/login?returnUrl=/rejoindre/{Token}")" style="color: var(--gold-dark); font-weight: 700;">Se connecter</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Token { get; set; } = "";

    private bool GoogleEnabled => !string.IsNullOrEmpty(Configuration["Authentication:Google:ClientId"]);
    private bool MicrosoftEnabled => !string.IsNullOrEmpty(Configuration["Authentication:Microsoft:ClientId"]);

    private ShareInvite? invite;
    private string adminName = "";
    private string playerNames = "";
    private string? invalidReason;

    private string firstName = "";
    private string lastName = "";
    private string email = "";
    private string password = "";
    private string passwordConfirm = "";
    private string? formError;
    private bool submitting;

    private bool attaching;
    private bool attachSuccess;
    private string? attachError;

    protected override async Task OnInitializedAsync()
    {
        var validation = await ShareInviteSvc.ValidateTokenAsync(Token);
        invite = validation.Invite;

        if (validation.State != ShareInviteTokenState.Valid)
        {
            invalidReason = validation.State switch
            {
                ShareInviteTokenState.Expired => "Ce lien de partage a expiré.",
                ShareInviteTokenState.AlreadyClaimed => "Ce lien de partage a déjà été utilisé.",
                ShareInviteTokenState.Revoked => "Ce lien de partage n'est plus valable.",
                _ => "Ce lien de partage est invalide."
            };
            return;
        }

        adminName = invite!.CreatedByAdmin is not null ? $"{invite.CreatedByAdmin.FirstName} {invite.CreatedByAdmin.LastName}" : "Un administrateur";
        playerNames = ShareInviteService.PlayerNames(invite.Players);
    }

    private async Task AttachToCurrentUser()
    {
        attaching = true;
        attachError = null;
        var currentUser = await CurrentUser.GetCurrentUserAsync();
        var error = await ShareInviteSvc.AttachToExistingUserAsync(Token, currentUser.Id);
        attaching = false;

        if (error == ShareInviteAttachError.RoleMismatch)
        {
            attachError = "Ce compte a déjà un rôle différent (Utilisateur/Consultant) ; contactez l'administrateur pour l'ajuster.";
            return;
        }

        attachSuccess = true;
    }

    private async Task Submit()
    {
        formError = null;

        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
        {
            formError = "Prénom et nom sont obligatoires.";
            return;
        }
        if (string.IsNullOrWhiteSpace(password) || password.Length < 6)
        {
            formError = "Le mot de passe doit contenir au moins 6 caractères.";
            return;
        }
        if (password != passwordConfirm)
        {
            formError = "Les mots de passe ne correspondent pas.";
            return;
        }

        submitting = true;
        try
        {
            await ShareInviteSvc.ClaimAsNewAccountAsync(Token, firstName.Trim(), lastName.Trim(), email, password);
        }
        catch (InvalidOperationException ex) when (ex.Message.StartsWith("EMAIL_TAKEN", StringComparison.Ordinal))
        {
            submitting = false;
            formError = $"Cette adresse email est déjà utilisée par un compte existant. Connectez-vous plutôt avec ce compte pour y ajouter cet accès.";
            return;
        }
        submitting = false;

        Nav.NavigateTo("/login?created=1", forceLoad: true);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split('.', ' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0]))).PadLeft(1, '?');
    }
}
