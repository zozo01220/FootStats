@page "/mot-de-passe-oublie"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout
@rendermode InteractiveServer
@inject InvitationService InvitationSvc
@inject ILogger<ForgotPassword> Logger

<PageTitle>Mot de passe oublié - FootStats</PageTitle>

<div class="login-shell">
    <div class="login-pitch">
        <div class="login-glow" aria-hidden="true"></div>
        <div class="login-eyebrow">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--gold);"></div>
            <span>Mot de passe oublié</span>
        </div>
        <div class="login-titleblock">
            <h1 class="login-title">
                FOOT<span style="color: var(--gold);">STATS</span>
            </h1>
            <div class="login-subtitle">Reçois un lien par email pour choisir un nouveau mot de passe.</div>
        </div>
    </div>

    <div class="login-form-side">
        <div class="card login-card">
            <div class="login-card-handle" aria-hidden="true"></div>

            @if (result is not null)
            {
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <h1 style="font-size: 23px; margin: 0;">@ResultTitle</h1>
                    <div class="alert @(result == PasswordResetRequestResult.Sent ? "alert-success" : "alert-danger")">
                        @ResultMessage
                    </div>
                </div>
                @if (result == PasswordResetRequestResult.Sent)
                {
                    <a class="btn btn-primary btn-block" href="/login" style="margin-top: 8px;">Retour à la connexion</a>
                }
                else
                {
                    <button class="btn btn-primary btn-block" type="button" style="margin-top: 8px;" @onclick="() => result = null">Réessayer</button>
                }
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <h1 style="font-size: 23px; margin: 0;">Mot de passe oublié</h1>
                    <div style="font-size: 13px; color: var(--muted);">Indique ton nom d'utilisateur ou ton email, on t'envoie un lien de réinitialisation.</div>
                </div>

                <EditForm Model="this" OnValidSubmit="Submit" style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="field">
                        <label>Nom d'utilisateur ou email</label>
                        <input type="text" @bind="usernameOrEmail" required autofocus />
                    </div>
                    <button class="btn btn-primary btn-block" type="submit" disabled="@submitting">Envoyer le lien</button>
                </EditForm>

                <div style="text-align: center; font-size: 13px; color: var(--muted);">
                    <a href="/login" style="color: var(--gold-dark); font-weight: 700;">Retour à la connexion</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string usernameOrEmail = "";
    private bool submitting;
    private PasswordResetRequestResult? result;

    private string ResultTitle => result switch
    {
        PasswordResetRequestResult.Sent => "Email envoyé",
        PasswordResetRequestResult.NotFound => "Adresse non reconnue",
        PasswordResetRequestResult.NoEmailOnFile => "Aucun email enregistré",
        _ => "Envoi impossible"
    };

    private string ResultMessage => result switch
    {
        PasswordResetRequestResult.Sent => "Un email vient d'être envoyé avec un lien de réinitialisation. Ce lien expire dans 30 minutes.",
        PasswordResetRequestResult.NotFound => "Aucun compte actif ne correspond à ce nom d'utilisateur ou cet email. Vérifiez la saisie ou contactez un administrateur.",
        PasswordResetRequestResult.NoEmailOnFile => "Ce compte n'a pas d'adresse email enregistrée : impossible d'y envoyer un lien. Contactez un administrateur pour en ajouter une.",
        _ => "Une erreur est survenue lors de l'envoi de l'email. Réessayez dans quelques instants ou contactez un administrateur."
    };

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(usernameOrEmail)) return;

        submitting = true;
        try
        {
            result = await InvitationSvc.RequestPasswordResetAsync(usernameOrEmail);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Échec de la demande de réinitialisation de mot de passe.");
            result = PasswordResetRequestResult.SendFailed;
        }
        submitting = false;
    }
}
