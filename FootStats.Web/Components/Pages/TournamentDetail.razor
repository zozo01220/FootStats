@page "/tournaments/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject ConfirmService Confirm
@inject CurrentUserService CurrentUser
@inject LiveMatchNotifier Notifier
@inject MatchShareLinkService ShareLinkSvc
@inject IJSRuntime JS

<PageTitle>@(tournament?.Name ?? tournament?.EventType.ToString()) - FootStats</PageTitle>

@if (tournament is null)
{
    <div class="container"><p class="empty-note">@(notFound ? "Événement introuvable." : "Chargement...")</p></div>
}
else
{
    <div class="container">
        <a href="/seasons/@tournament.SeasonId" class="back-link">
            <svg viewBox="0 0 24 24" class="icon" style="width:14px;height:14px;"><path d="M15 6l-6 6 6 6"></path></svg>
            @tournament.Season?.Label
        </a>

        <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 4px; flex-wrap: wrap;">
                <span class="pill pill-gold">@tournament.EventType</span>
                @if (!string.IsNullOrWhiteSpace(tournament.Season?.Category))
                {
                    <span class="pill">@tournament.Season.Category</span>
                }
                <span class="pill">Équipe @tournament.TeamNumber</span>
            </div>
            <h1 class="page-title" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <span>@(tournament.Name ?? tournament.EventType.ToString())</span>
                <span class="page-title-sep">-</span>
                <PlayerBadge Player="tournament.Season?.Player" Club="eventClub" />
            </h1>
            <div style="font-size: 15px; color: var(--muted);">@tournament.City &middot; @tournament.Date.ToString("dd.MM.yyyy")</div>
            @if (canManage)
            {
                <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; flex-wrap: wrap;">
                    <span style="font-size: 12.5px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Présence</span>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="attendance-pick present @(tournament.AttendanceStatus == AttendanceStatus.Present ? "selected" : "")" @onclick="() => ToggleAttendance(AttendanceStatus.Present)">Présent</button>
                        <button type="button" class="attendance-pick excused @(tournament.AttendanceStatus == AttendanceStatus.Excused ? "selected" : "")" @onclick="() => ToggleAttendance(AttendanceStatus.Excused)">Excusé</button>
                        <button type="button" class="attendance-pick absent @(tournament.AttendanceStatus == AttendanceStatus.Absent ? "selected" : "")" @onclick="() => ToggleAttendance(AttendanceStatus.Absent)">Absent</button>
                    </div>
                </div>

                <div class="tournament-live-share" style="margin-top: 10px;">
                    <button type="button" class="btn btn-secondary btn-share-green" title="Partager le suivi en direct de l'évènement" @onclick="OpenShare">
                        <svg viewBox="0 0 24 24" class="icon"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line><line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line></svg>
                        <span>Partager</span>
                    </button>
                </div>
            }
        </div>

        <div class="card">
            <div class="score-table-wrap matches-table" style="padding: 8px 4px 6px;">
                <div class="score-row head" style="grid-template-columns: 56px 22px 1fr 0.85fr 0.7fr 0.5fr 0.6fr 0.6fr 0.8fr 76px;">
                    <span>Équipe</span><span></span><span>Adversaire</span><span>Statut</span><span>Poste</span><span>@scoreWord (fils)</span><span>Passes D.</span><span>Complet</span><span>Score équipe</span><span></span>
                </div>
                @foreach (var m in tournament.Matches)
                {
                    <div class="score-row" style="grid-template-columns: 56px 22px 1fr 0.85fr 0.7fr 0.5fr 0.6fr 0.6fr 0.8fr 76px;">
                        <div class="team-chip">@tournament.TeamNumber</div>
                        <span class="captain-star-cell">
                            @if (m.IsCaptain)
                            {
                                <svg viewBox="0 0 24 24" class="captain-star" title="Capitaine" aria-label="Capitaine"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                            }
                        </span>
                        <span class="muted row-title" data-label="Adversaire">
                            @m.Opponent
                            @if (!string.IsNullOrWhiteSpace(m.Note))
                            {
                                <svg viewBox="0 0 24 24" class="icon match-note-icon" title="@m.Note" aria-label="Anecdote : @m.Note"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            }
                        </span>
                        <span data-label="Statut">
                            <span class="starter-chip @(m.IsStarter ? "yes" : "no")">@(m.IsStarter ? "Titulaire" : "Remplaçant")</span>
                        </span>
                        <span class="muted" data-label="Poste">@(m.Position ?? "—")</span>
                        <span data-label="@scoreWord (fils)" style="font-family: var(--font-display); font-size: 17px;">@m.PlayerGoals</span>
                        <span data-label="Passes D." style="font-family: var(--font-display); font-size: 17px; color: var(--gold-dark);">@m.PlayerAssists</span>
                        <span class="full-match-cell" data-label="Complet" title="@(m.PlayedFullMatch ? "Match complet" : "Sorti avant la fin")">
                            @if (m.PlayedFullMatch)
                            {
                                <svg viewBox="0 0 24 24" class="icon" style="color: var(--pitch);" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" class="icon" style="color: var(--muted);" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"></path></svg>
                            }
                        </span>
                        <span data-label="Score équipe">@m.TeamGoalsFor - @m.TeamGoalsAgainst</span>
                        @if (canManage)
                        {
                            <div class="row-actions">
                                <button class="icon-action" @onclick="() => OpenEdit(m)" aria-label="Modifier" title="Modifier">
                                    <svg viewBox="0 0 24 24" class="icon"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
                                </button>
                                <button class="icon-action delete" @onclick="() => DeleteMatch(m.Id)" aria-label="Supprimer" title="Supprimer">
                                    <svg viewBox="0 0 24 24" class="icon"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path></svg>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="match-card-mobile">
                        <div class="card-stripe @MatchResultClass(m)"></div>
                        <div class="mcm-body">
                            <div class="mcm-top">
                                <div class="team-chip">@tournament.TeamNumber</div>
                                <div class="mcm-head-text">
                                    <div class="mcm-vs">Contre</div>
                                    <div class="mcm-opponent">
                                        @m.Opponent
                                        @if (m.IsCaptain)
                                        {
                                            <svg viewBox="0 0 24 24" class="captain-star" style="width: 15px; height: 15px;" title="Capitaine" aria-label="Capitaine"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                                        }
                                    </div>
                                    @if (m.IsLive)
                                    {
                                        <span class="mcm-result-tag live"><span class="live-dot"></span>EN COURS · @ElapsedLabel(m)</span>
                                    }
                                    else
                                    {
                                        <span class="mcm-result-tag @MatchResultClass(m)">@MatchResultLabel(m)</span>
                                    }
                                </div>
                                <div class="mcm-score">@m.TeamGoalsFor<span class="sep">-</span>@m.TeamGoalsAgainst</div>
                            </div>

                            <div class="mcm-strip">
                                <span class="mcm-kpi">
                                    <svg viewBox="0 0 24 24" class="icon"><circle cx="12" cy="12" r="9.5"></circle></svg>
                                    @m.PlayerGoals @scoreWord.ToLowerInvariant()
                                </span>
                                <span class="mcm-kpi">
                                    <svg viewBox="0 0 24 24" class="icon assist"><path d="M3 17l6-6 4 4 8-8"></path><path d="M15 7h6v6"></path></svg>
                                    @m.PlayerAssists passe(s) D.
                                </span>
                                @if (!string.IsNullOrWhiteSpace(m.Position))
                                {
                                    <span class="muted" style="font-size: 12px;">&middot; @m.Position</span>
                                }
                                <div class="mcm-flags">
                                    <span class="mcm-flag @(m.IsStarter ? "on" : "")" title="@(m.IsStarter ? "Titulaire" : "Remplaçant")">
                                        <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg>
                                    </span>
                                    <span class="mcm-flag @(m.PlayedFullMatch ? "on" : "")" title="@(m.PlayedFullMatch ? "Match complet" : "Sorti avant la fin")">
                                        <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle></svg>
                                    </span>
                                </div>
                            </div>

                            @if (canManage && m.StartedAt is null && tournament.Date == DateOnly.FromDateTime(DateTime.Today))
                            {
                                <button type="button" class="live-btn live-btn-start" @onclick="() => OpenStartMatch(m)">▶ Démarrer</button>
                            }

                            @if (m.IsLive)
                            {
                                <div class="mcm-live-panel">
                                    <div class="mcm-live-chrono">
                                        <span class="live-label"><span class="live-dot"></span>@ElapsedLabel(m)@(m.DurationMinutes is { } dur ? $" / {dur}'" : "")</span>
                                        <span>@m.TeamGoalsFor – @m.TeamGoalsAgainst</span>
                                    </div>

                                    <div class="mcm-onfield-row">
                                        <span class="mcm-onfield-status @(m.OnField ? "on" : "off")"><span class="dot"></span>@(m.OnField ? "Sur le terrain" : "Sur le banc")</span>
                                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12.5px; font-weight: 600;">
                                            Titulaire
                                            <span class="toggle-switch">
                                                <input type="checkbox" checked="@m.IsStarter" @onchange="e => SetStarter(m, (bool)e.Value!)" />
                                                <span class="toggle-slider"></span>
                                            </span>
                                        </label>
                                    </div>

                                    <div class="mcm-live-row">
                                        <button type="button" class="live-btn live-btn-out" disabled="@(!m.OnField)" @onclick="() => ExitPlayer(m)">Sortir</button>
                                        <button type="button" class="live-btn live-btn-in" disabled="@m.OnField" @onclick="() => EnterPlayer(m)">Entrer</button>
                                    </div>

                                    <div class="mcm-live-counts">
                                        <span>@m.PlayerGoals but(s)</span>
                                        <span>@m.PlayerAssists passe(s) D.</span>
                                    </div>

                                    <div class="mcm-live-row">
                                        <button type="button" class="live-btn live-btn-goal" @onclick="() => AddGoal(m)">+ But @tournament.Season?.Player?.FirstName</button>
                                        <button type="button" class="live-btn live-btn-assist" @onclick="() => AddAssist(m)">+ Passe D.</button>
                                    </div>
                                    <div class="mcm-live-row">
                                        <button type="button" class="live-btn live-btn-teamgoal" @onclick="() => AddTeamGoal(m)">+ But</button>
                                        <button type="button" class="live-btn live-btn-opponent" @onclick="() => AddOpponentGoal(m)">+ But adverse</button>
                                    </div>

                                    <button type="button" class="live-btn live-btn-undo" @onclick="() => UndoLastEvent(m)">
                                        <svg viewBox="0 0 24 24" class="icon" style="width:14px;height:14px;" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M3 13a9 9 0 1 0 3-6.7L3 9"></path></svg>
                                        Annuler la dernière action
                                    </button>

                                    <button type="button" class="live-btn live-btn-stop" @onclick="() => StopMatch(m)">■ Arrêter le match</button>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(m.Note))
                            {
                                <div class="mcm-note">
                                    <svg viewBox="0 0 24 24" class="icon"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    <span>@m.Note</span>
                                </div>
                            }

                            @if (canManage)
                            {
                                <div class="mcm-actions">
                                    <button class="icon-action" @onclick="() => OpenEdit(m)" aria-label="Modifier" title="Modifier">
                                        <svg viewBox="0 0 24 24" class="icon"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
                                    </button>
                                    <button class="icon-action delete" @onclick="() => DeleteMatch(m.Id)" aria-label="Supprimer" title="Supprimer">
                                        <svg viewBox="0 0 24 24" class="icon"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (tournament.Matches.Count == 0)
                {
                    <p class="empty-note">Aucun match enregistré.</p>
                }
            </div>
        </div>

        @if (canManage)
        {
            <CreateFab @ref="fab" Label="Nouveau match" Floating="true">
                <Subtitle>
                    <PlayerBadge Player="tournament.Season?.Player" Club="eventClub" />
                </Subtitle>
                <ChildContent>
                    <EditForm Model="form" OnValidSubmit="AddMatch">
                        <div class="field" style="margin-bottom: 16px;">
                            <label>Adversaire</label>
                            <input @bind="form.Opponent" />
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>Poste joué sur ce match</label>
                            <select @bind="form.Position">
                                <option value="">-- Comme d'habitude --</option>
                                <option>Gardien</option>
                                <option>Défenseur</option>
                                <option>Milieu</option>
                                <option>Attaquant</option>
                            </select>
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>Durée du match (minutes)</label>
                            <input type="number" min="0" @bind="form.DurationMinutes" placeholder="ex. 60" />
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>@scoreWord fils</label>
                            <input type="number" min="0" @bind="form.PlayerGoals" />
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>Passes décisives</label>
                            <input type="number" min="0" @bind="form.PlayerAssists" />
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>@scoreWord équipe</label>
                            <input type="number" min="0" @bind="form.TeamGoalsFor" />
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>@scoreWord adverses</label>
                            <input type="number" min="0" @bind="form.TeamGoalsAgainst" />
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <span class="toggle-switch">
                                    <input type="checkbox" @bind="form.IsStarter" />
                                    <span class="toggle-slider"></span>
                                </span>
                                Titulaire
                            </label>
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <span class="toggle-switch">
                                    <input type="checkbox" @bind="form.PlayedFullMatch" />
                                    <span class="toggle-slider"></span>
                                </span>
                                Match complet
                            </label>
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <span class="toggle-switch">
                                    <input type="checkbox" @bind="form.IsCaptain" />
                                    <span class="toggle-slider"></span>
                                </span>
                                Capitaine sur ce match
                            </label>
                        </div>
                        <div class="field" style="margin-bottom: 16px;">
                            <label>Anecdote / souvenir (optionnel)</label>
                            <textarea @bind="form.Note" rows="2" placeholder="Un moment marquant de ce match..."></textarea>
                        </div>
                        <button class="btn btn-primary" type="submit">Ajouter</button>
                    </EditForm>
                </ChildContent>
            </CreateFab>
        }
    </div>

    <Modal @ref="editModal" Label="Modifier le match">
        <Subtitle>
            <PlayerBadge Player="tournament.Season?.Player" Club="eventClub" />
        </Subtitle>
        <ChildContent>
            <EditForm Model="editForm" OnValidSubmit="SaveEdit">
                <div class="field" style="margin-bottom: 16px;">
                    <label>Adversaire</label>
                    <input @bind="editForm.Opponent" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>Poste joué sur ce match</label>
                    <select @bind="editForm.Position">
                        <option value="">-- Comme d'habitude --</option>
                        <option>Gardien</option>
                        <option>Défenseur</option>
                        <option>Milieu</option>
                        <option>Attaquant</option>
                    </select>
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>Durée du match (minutes)</label>
                    <input type="number" min="0" @bind="editForm.DurationMinutes" placeholder="ex. 60" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>@scoreWord fils</label>
                    <input type="number" min="0" @bind="editForm.PlayerGoals" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>Passes décisives</label>
                    <input type="number" min="0" @bind="editForm.PlayerAssists" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>@scoreWord équipe</label>
                    <input type="number" min="0" @bind="editForm.TeamGoalsFor" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>@scoreWord adverses</label>
                    <input type="number" min="0" @bind="editForm.TeamGoalsAgainst" />
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                        <span class="toggle-switch">
                            <input type="checkbox" @bind="editForm.IsStarter" />
                            <span class="toggle-slider"></span>
                        </span>
                        Titulaire
                    </label>
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                        <span class="toggle-switch">
                            <input type="checkbox" @bind="editForm.PlayedFullMatch" />
                            <span class="toggle-slider"></span>
                        </span>
                        Match complet
                    </label>
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                        <span class="toggle-switch">
                            <input type="checkbox" @bind="editForm.IsCaptain" />
                            <span class="toggle-slider"></span>
                        </span>
                        Capitaine sur ce match
                    </label>
                </div>
                <div class="field" style="margin-bottom: 16px;">
                    <label>Anecdote / souvenir (optionnel)</label>
                    <textarea @bind="editForm.Note" rows="2" placeholder="Un moment marquant de ce match..."></textarea>
                </div>
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            </EditForm>
        </ChildContent>
    </Modal>

    <Modal @ref="shareModal" Label="Partager le suivi en direct">
        <ChildContent>
            @if (shareSuccess)
            {
                <p class="empty-note" style="color: var(--pitch); font-weight: 700;">Partagé via WhatsApp.</p>
            }
            else
            {
                <p class="empty-note" style="margin: -8px 0 14px;">La famille pourra suivre le score sans se connecter, pendant 48h.</p>
                <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;">
                    @if (familyMembers.Count == 0)
                    {
                        <p class="empty-note">Aucun autre membre de la famille pour l'instant.</p>
                    }
                    @foreach (var member in familyMembers)
                    {
                        var isChecked = selectedFamilyIds.Contains(member.Id);
                        <label class="live-family-row @(isChecked ? "selected" : "")">
                            <input type="checkbox" style="display: none;" checked="@isChecked" @onchange="e => ToggleFamilySelection(member.Id, (bool)e.Value!)" />
                            <span class="live-family-check">
                                @if (isChecked)
                                {
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg>
                                }
                            </span>
                            <span class="live-family-avatar">@PlayerInitials(member.FirstName, member.LastName)</span>
                            <span>
                                <div style="font-weight: 700; font-size: 13.5px;">@member.FirstName @member.LastName</div>
                                @if (!string.IsNullOrWhiteSpace(member.Relationship))
                                {
                                    <div style="font-size: 11.5px; color: var(--muted);">@member.Relationship</div>
                                }
                            </span>
                        </label>
                    }
                </div>
                <button type="button" class="live-btn live-btn-whatsapp" style="width: 100%;" disabled="@shareSending" @onclick="ShareViaWhatsApp">
                    @(shareSending ? "Génération..." : "Partager via WhatsApp")
                </button>
            }
        </ChildContent>
    </Modal>

    <Modal @ref="startModal" Label="Coup d'envoi">
        <ChildContent>
            <p class="empty-note" style="margin: -8px 0 14px;">
                @(matchToStart?.Opponent is { Length: > 0 } opp ? $"Contre {opp}. " : "")Comment @tournament.Season?.Player?.FirstName démarre-t-il ce match ?
            </p>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button type="button" class="live-btn live-btn-start" @onclick="() => ConfirmStartMatch(true)">Titulaire</button>
                <button type="button" class="live-btn live-btn-in" @onclick="() => ConfirmStartMatch(false)">Remplaçant</button>
            </div>
        </ChildContent>
    </Modal>
}

@code {
    [Parameter] public int Id { get; set; }

    private Tournament? tournament;
    private Club? eventClub;
    private string scoreWord = "Buts";
    private MatchForm form = new();
    private MatchForm editForm = new();
    private CreateFab? fab;
    private Modal? editModal;
    private int editingMatchId;
    private bool canManage;
    private bool notFound;

    // Suivi live (mobile uniquement — voir CLAUDE.md) : rafraîchissement cross-circuit et chrono.
    private Modal? shareModal;
    private Modal? startModal;
    private MatchRecord? matchToStart;
    private List<AppUser> familyMembers = [];
    private HashSet<int> selectedFamilyIds = [];
    private bool shareSending;
    private bool shareSuccess;
    private PeriodicTimer? liveTimer;
    private CancellationTokenSource? liveTimerCts;

    protected override async Task OnInitializedAsync()
    {
        var seasonPlayerId = await Db.Tournaments.Where(t => t.Id == Id).Select(t => t.Season!.PlayerId).FirstOrDefaultAsync();
        if (seasonPlayerId == 0 || !await CurrentUser.CanSeePlayerAsync(seasonPlayerId))
        {
            notFound = true;
            return;
        }

        canManage = await CurrentUser.CanManageFamilyDataAsync();
        Notifier.TournamentChanged += OnTournamentChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        tournament = await Db.Tournaments
            .Include(t => t.Season!.Player)
            .Include(t => t.Season!.Club)
            .Include(t => t.Matches)
            .FirstOrDefaultAsync(t => t.Id == Id);
        if (tournament?.Season is not null)
        {
            scoreWord = SportDisplay.ScoreWord(tournament.Season.Sport);

            var memberships = await Db.PlayerClubs.Include(m => m.Club)
                .Where(m => m.PlayerId == tournament.Season.PlayerId)
                .OrderBy(m => m.StartDate)
                .ToListAsync();
            eventClub = ClubTimelineHelper.ClubAt(memberships, tournament.Date, tournament.Season.Club);
            form.Position = tournament.Season.Player?.Position ?? "";
        }
        EnsureLiveTimer();
    }

    /// <summary>Un autre circuit (fiche match d'un autre membre, page famille) a modifié ce tournoi :
    /// recharge et rafraîchit l'affichage. Voir <see cref="LiveMatchNotifier"/> et CLAUDE.md, "Render modes".</summary>
    private void OnTournamentChanged(int tournamentId)
    {
        if (tournament?.Id != tournamentId) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    /// <summary>Démarre ou arrête le tic du chrono (1s) selon qu'un match de ce tournoi est en direct ou non.</summary>
    private void EnsureLiveTimer()
    {
        var anyLive = tournament?.Matches.Any(m => m.IsLive) == true;
        if (anyLive && liveTimer is null)
        {
            liveTimerCts = new CancellationTokenSource();
            liveTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _ = RunLiveTimerAsync(liveTimer, liveTimerCts.Token);
        }
        else if (!anyLive && liveTimer is not null)
        {
            liveTimerCts?.Cancel();
            liveTimer.Dispose();
            liveTimer = null;
        }
    }

    private async Task RunLiveTimerAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private static string ElapsedLabel(MatchRecord m)
    {
        if (m.StartedAt is null) return "00:00";
        var elapsed = (m.EndedAt ?? DateTime.UtcNow) - m.StartedAt.Value;
        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
        return $"{(int)elapsed.TotalMinutes:D2}:{elapsed.Seconds:D2}";
    }

    private void AddMatchEvent(MatchRecord m, MatchEventType type)
    {
        var minute = m.StartedAt is null ? 0 : (int)Math.Round((DateTime.UtcNow - m.StartedAt.Value).TotalMinutes);
        Db.MatchEvents.Add(new MatchEvent { MatchRecordId = m.Id, Type = type, MinuteMark = Math.Max(0, minute) });
    }

    /// <summary>Ouvre le choix titulaire/remplaçant avant de démarrer : forcé à chaque coup d'envoi (pas de valeur
    /// par défaut silencieuse) car la composition peut différer de ce qui a été saisi à la création du match.</summary>
    private void OpenStartMatch(MatchRecord m)
    {
        if (!canManage) return;
        matchToStart = m;
        startModal?.Open();
    }

    private async Task ConfirmStartMatch(bool isStarter)
    {
        if (matchToStart is not { } m) return;
        m.IsStarter = isStarter;
        m.OnField = isStarter;
        m.StartedAt = DateTime.UtcNow;
        AddMatchEvent(m, MatchEventType.Kickoff);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
        EnsureLiveTimer();
        matchToStart = null;
        startModal?.Close();
    }

    private async Task StopMatch(MatchRecord m)
    {
        if (!canManage) return;
        if (!await Confirm.AskAsync(new ConfirmRequest
        {
            Title = "Arrêter le match",
            Message = "Le chrono s'arrête et le score n'évoluera plus pour les autres membres de la famille. Les statistiques restent modifiables ensuite depuis la fiche.",
            ConfirmLabel = "Arrêter",
            Icon = ConfirmIcon.Power,
            SubjectName = string.IsNullOrWhiteSpace(m.Opponent) ? $"Équipe {tournament!.TeamNumber}" : m.Opponent,
            SubjectMeta = $"{ElapsedLabel(m)} · {m.TeamGoalsFor} – {m.TeamGoalsAgainst}"
        })) return;

        m.EndedAt = DateTime.UtcNow;
        AddMatchEvent(m, MatchEventType.FullTime);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
        EnsureLiveTimer();
    }

    private async Task EnterPlayer(MatchRecord m)
    {
        if (!canManage || m.OnField) return;
        m.OnField = true;
        AddMatchEvent(m, MatchEventType.PlayerIn);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    private async Task ExitPlayer(MatchRecord m)
    {
        if (!canManage || !m.OnField) return;
        m.OnField = false;
        AddMatchEvent(m, MatchEventType.PlayerOut);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    private async Task SetStarter(MatchRecord m, bool isStarter)
    {
        if (!canManage || m.IsStarter == isStarter) return;
        m.IsStarter = isStarter;
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    private async Task AddGoal(MatchRecord m)
    {
        if (!canManage) return;
        m.PlayerGoals++;
        m.TeamGoalsFor++;
        AddMatchEvent(m, MatchEventType.Goal);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    /// <summary>But marqué par un coéquipier (pas par le fils suivi) : compte dans le score de l'équipe mais
    /// jamais dans les buts personnels.</summary>
    private async Task AddTeamGoal(MatchRecord m)
    {
        if (!canManage) return;
        m.TeamGoalsFor++;
        AddMatchEvent(m, MatchEventType.TeammateGoal);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    /// <summary>Une passe décisive suppose qu'un but a été marqué grâce à elle : le score de l'équipe avance aussi,
    /// mais le but ne compte pas pour le fils suivi (ce n'est pas lui qui l'a marqué).</summary>
    private async Task AddAssist(MatchRecord m)
    {
        if (!canManage) return;
        m.PlayerAssists++;
        m.TeamGoalsFor++;
        AddMatchEvent(m, MatchEventType.Assist);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    private async Task AddOpponentGoal(MatchRecord m)
    {
        if (!canManage) return;
        m.TeamGoalsAgainst++;
        AddMatchEvent(m, MatchEventType.OpponentGoal);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
    }

    /// <summary>Annule le dernier pointage (but, passe, but adverse, entrée/sortie...) en cas d'erreur de saisie :
    /// retire l'évènement et défait son effet sur les compteurs du match.</summary>
    private async Task UndoLastEvent(MatchRecord m)
    {
        if (!canManage) return;
        var last = await Db.MatchEvents
            .Where(e => e.MatchRecordId == m.Id)
            .OrderByDescending(e => e.Id)
            .FirstOrDefaultAsync();
        if (last is null) return;

        switch (last.Type)
        {
            case MatchEventType.Goal:
                m.PlayerGoals = Math.Max(0, m.PlayerGoals - 1);
                m.TeamGoalsFor = Math.Max(0, m.TeamGoalsFor - 1);
                break;
            case MatchEventType.TeammateGoal:
                m.TeamGoalsFor = Math.Max(0, m.TeamGoalsFor - 1);
                break;
            case MatchEventType.Assist:
                m.PlayerAssists = Math.Max(0, m.PlayerAssists - 1);
                m.TeamGoalsFor = Math.Max(0, m.TeamGoalsFor - 1);
                break;
            case MatchEventType.OpponentGoal:
                m.TeamGoalsAgainst = Math.Max(0, m.TeamGoalsAgainst - 1);
                break;
            case MatchEventType.PlayerIn:
                m.OnField = false;
                break;
            case MatchEventType.PlayerOut:
                m.OnField = true;
                break;
            case MatchEventType.Kickoff:
                m.StartedAt = null;
                break;
            case MatchEventType.FullTime:
                m.EndedAt = null;
                break;
        }

        Db.MatchEvents.Remove(last);
        await Db.SaveChangesAsync();
        Notifier.NotifyTournamentChanged(m.TournamentId);
        EnsureLiveTimer();
    }

    private async Task OpenShare()
    {
        if (!canManage || tournament?.Season?.Player?.OwnerAdminId is not { } adminId) return;
        familyMembers = await FamilyMembersHelper.GetForAdminAsync(Db, adminId);
        var currentUser = await CurrentUser.GetCurrentUserAsync();
        selectedFamilyIds = familyMembers.Where(u => u.Id != currentUser.Id).Select(u => u.Id).ToHashSet();
        shareSuccess = false;
        shareModal?.Open();
    }

    private void ToggleFamilySelection(int userId, bool isChecked)
    {
        if (isChecked) selectedFamilyIds.Add(userId);
        else selectedFamilyIds.Remove(userId);
    }

    private async Task ShareViaWhatsApp()
    {
        if (tournament?.Season?.Player is null) return;
        shareSending = true;
        var currentUser = await CurrentUser.GetCurrentUserAsync();
        var (_, rawToken) = await ShareLinkSvc.CreateAsync(tournament.Id, currentUser.Id);

        var recipientNames = familyMembers.Where(u => selectedFamilyIds.Contains(u.Id)).Select(u => u.FirstName).ToList();
        var greeting = recipientNames.Count > 0 ? string.Join(", ", recipientNames) + " : " : "";
        var eventLabel = tournament.Name ?? tournament.EventType.ToString();
        var message = $"{greeting}suivez {eventLabel} de {tournament.Season.Player.FirstName} en direct sur FootStats :";

        var url = ShareLinkSvc.BuildWhatsAppShareUrl(rawToken, message);
        await JS.InvokeVoidAsync("footstats.openInNewTab", url);

        shareSending = false;
        shareSuccess = true;
        StateHasChanged();
        await Task.Delay(1500);
        shareModal?.Close();
    }

    private static string PlayerInitials(string firstName, string lastName)
    {
        var a = firstName.Length > 0 ? firstName[0].ToString() : "";
        var b = lastName.Length > 0 ? lastName[0].ToString() : "";
        return (a + b).ToUpper();
    }

    public void Dispose()
    {
        Notifier.TournamentChanged -= OnTournamentChanged;
        liveTimerCts?.Cancel();
        liveTimer?.Dispose();
    }

    /// <summary>Pointe la présence sur l'entité <see cref="Tournament"/> elle-même (pas de table à part comme
    /// <see cref="TrainingAttendance"/> : un tournoi n'est pas récurrent). Recliquer le même statut le retire.</summary>
    private async Task ToggleAttendance(AttendanceStatus status)
    {
        if (!canManage || tournament is null) return;
        tournament.AttendanceStatus = tournament.AttendanceStatus == status ? null : status;
        await Db.SaveChangesAsync();
    }

    private async Task AddMatch()
    {
        if (!canManage) return;
        Db.Matches.Add(new MatchRecord
        {
            TournamentId = Id,
            Opponent = string.IsNullOrWhiteSpace(form.Opponent) ? null : form.Opponent.Trim(),
            PlayerGoals = form.PlayerGoals,
            PlayerAssists = form.PlayerAssists,
            TeamGoalsFor = form.TeamGoalsFor,
            TeamGoalsAgainst = form.TeamGoalsAgainst,
            IsCaptain = form.IsCaptain,
            IsStarter = form.IsStarter,
            PlayedFullMatch = form.PlayedFullMatch,
            Position = string.IsNullOrWhiteSpace(form.Position) ? null : form.Position,
            Note = string.IsNullOrWhiteSpace(form.Note) ? null : form.Note.Trim(),
            DurationMinutes = form.DurationMinutes
        });
        await Db.SaveChangesAsync();
        form = new MatchForm();
        fab?.Close();
        await LoadAsync();
        Notifier.NotifyTournamentChanged(Id);
    }

    private void OpenEdit(MatchRecord match)
    {
        if (!canManage) return;
        editingMatchId = match.Id;
        editForm = new MatchForm
        {
            Opponent = match.Opponent ?? "",
            PlayerGoals = match.PlayerGoals,
            PlayerAssists = match.PlayerAssists,
            TeamGoalsFor = match.TeamGoalsFor,
            TeamGoalsAgainst = match.TeamGoalsAgainst,
            IsCaptain = match.IsCaptain,
            IsStarter = match.IsStarter,
            PlayedFullMatch = match.PlayedFullMatch,
            Position = match.Position ?? "",
            Note = match.Note ?? "",
            DurationMinutes = match.DurationMinutes
        };
        editModal?.Open();
    }

    private async Task SaveEdit()
    {
        if (!canManage) return;
        var match = await Db.Matches.FindAsync(editingMatchId);
        if (match is null) return;

        match.Opponent = string.IsNullOrWhiteSpace(editForm.Opponent) ? null : editForm.Opponent.Trim();
        match.PlayerGoals = editForm.PlayerGoals;
        match.PlayerAssists = editForm.PlayerAssists;
        match.TeamGoalsFor = editForm.TeamGoalsFor;
        match.TeamGoalsAgainst = editForm.TeamGoalsAgainst;
        match.IsCaptain = editForm.IsCaptain;
        match.IsStarter = editForm.IsStarter;
        match.PlayedFullMatch = editForm.PlayedFullMatch;
        match.Position = string.IsNullOrWhiteSpace(editForm.Position) ? null : editForm.Position;
        match.Note = string.IsNullOrWhiteSpace(editForm.Note) ? null : editForm.Note.Trim();
        match.DurationMinutes = editForm.DurationMinutes;

        await Db.SaveChangesAsync();
        editModal?.Close();
        await LoadAsync();
        Notifier.NotifyTournamentChanged(match.TournamentId);
    }

    private async Task DeleteMatch(int matchId)
    {
        if (!canManage) return;
        var match = await Db.Matches.FindAsync(matchId);
        if (match is null) return;

        if (!await Confirm.AskAsync(new ConfirmRequest
        {
            Title = "Supprimer le match",
            Message = "Cette action est définitive : les buts et passes de ce match ne compteront plus dans les statistiques de la saison.",
            ConfirmLabel = "Supprimer",
            Tone = ConfirmTone.Danger,
            Icon = ConfirmIcon.Trash,
            SubjectName = string.IsNullOrWhiteSpace(match.Opponent) ? $"Équipe {tournament!.TeamNumber}" : match.Opponent,
            SubjectMeta = $"Équipe {tournament!.TeamNumber} · {match.TeamGoalsFor} – {match.TeamGoalsAgainst} · {match.PlayerGoals} but{(match.PlayerGoals > 1 ? "s" : "")}"
        })) return;

        var tournamentId = match.TournamentId;
        Db.Matches.Remove(match);
        await Db.SaveChangesAsync();
        await LoadAsync();
        Notifier.NotifyTournamentChanged(tournamentId);
    }

    private static string MatchResultClass(MatchRecord m) =>
        m.TeamGoalsFor > m.TeamGoalsAgainst ? "win" : m.TeamGoalsFor < m.TeamGoalsAgainst ? "loss" : "draw";

    private static string MatchResultLabel(MatchRecord m) =>
        m.TeamGoalsFor > m.TeamGoalsAgainst ? "Victoire" : m.TeamGoalsFor < m.TeamGoalsAgainst ? "Défaite" : "Nul";

    private class MatchForm
    {
        public string Opponent { get; set; } = "";
        public string Position { get; set; } = "";
        public int PlayerGoals { get; set; }
        public int PlayerAssists { get; set; }
        public int TeamGoalsFor { get; set; }
        public int TeamGoalsAgainst { get; set; }
        public bool IsCaptain { get; set; }
        public bool IsStarter { get; set; } = true;
        public bool PlayedFullMatch { get; set; }
        public string Note { get; set; } = "";
        public int? DurationMinutes { get; set; }
    }
