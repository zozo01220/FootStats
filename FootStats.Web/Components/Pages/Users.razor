    private RenderFragment UserCard(AppUser user) => @<div class="user-card" @onclick="() => OpenEdit(user)">
        @{
            var isSelf = !isSuperAdmin && user.Id == currentUser.Id;
            var category = RelationshipDisplay.Category(user.Relationship);
        }
        <div class="card-crest">
            @{
                var starClass = isSuperAdmin || isSelf ? "" : user.Role switch
                {
                    UserRole.User => "silver",
                    UserRole.Consultant => "bronze",
                    _ => ""
                };
            }
            @if (isSuperAdmin || isSelf)
            {
                <span class="admin-star" title="Administrateur" aria-label="Administrateur">
                    <svg viewBox="0 0 24 24" class="icon" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                </span>
            }
            else if (!string.IsNullOrEmpty(starClass))
            {
                <span class="admin-star @starClass" title="@RoleLabel(user.Role)" aria-label="@RoleLabel(user.Role)">
                    <svg viewBox="0 0 24 24" class="icon" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                </span>
            }
            @if (isSuperAdmin)
            {
                <span class="session-status-badge @(IsOnline(user) ? "online" : "offline")">
                    <span class="session-status-dot"></span>
                    @(IsOnline(user) ? "En ligne" : "Hors ligne")
                </span>
            }
            <div class="card-badge">@Initials(user)</div>
            <span class="club-acronym-caption">@RoleLabel(user.Role)</span>
        </div>
        <div class="card-body">
            <div class="card-title-row">
                <div class="card-title">@user.FirstName @user.LastName</div>
                @if (!isSuperAdmin && !isSelf && !string.IsNullOrWhiteSpace(user.Relationship))
                {
                    <span class="relationship-chip @CategoryClass(category) inline-chip">
                        <svg viewBox="0 0 24 24" class="icon"><circle cx="12" cy="7" r="4"></circle><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path></svg>
                        @user.Relationship
                    </span>
                }
            </div>
            @if (!isSuperAdmin && !isSelf && sharedViaLinkUserIds.Contains(user.Id))
            {
                <div class="card-line">
                    <svg viewBox="0 0 24 24" class="icon"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line><line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line></svg>
                    <span>Accès obtenu via un lien de partage</span>
                </div>
            }
            else if (!isSuperAdmin && !isSelf)
            {
                var invitation = LatestInvitation(user.Id);
                @if (invitation is not null)
                {
                    <div class="card-tags-row">
                        <span class="pill">@InvitationStatusLabel(invitation)</span>
                    </div>
                }
            }
            <div class="card-line">
                <svg viewBox="0 0 24 24" class="icon"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V8a5 5 0 0 1 10 0v3"></path></svg>
                <span>@user.Username</span>
            </div>
            @if (isSuperAdmin)
            {
                <div class="card-tags-row">
                    <span class="pill">@PlayerCount(user.Id) enfant@(PlayerCount(user.Id) > 1 ? "s" : "")</span>
                </div>
                <div class="card-line">
                    <svg viewBox="0 0 24 24" class="icon"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
                    <span>@LastSeenLabel(user)</span>
                </div>
            }
            else if (user.Players.Count > 0)
            {
                <div class="card-line">
                    <svg viewBox="0 0 24 24" class="icon"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span>@string.Join(", ", user.Players.Select(p => $"{p.FirstName} {p.LastName}"))</span>
                </div>
            }
            @if (!isSelf)
            {
                <div class="card-actions-row">
                    @if (isSuperAdmin && IsOnline(user))
                    {
                        <button class="btn btn-secondary" style="flex: 1;" type="button" @onclick:stopPropagation="true" @onclick="() => DisconnectUser(user.Id)">
                            <svg viewBox="0 0 24 24" class="icon"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
                            <span>Déconnecter</span>
                        </button>
                    }
                    <button class="btn btn-revoke" style="flex: 1;" type="button" @onclick:stopPropagation="true" @onclick="() => ToggleActive(user)">
                        @if (user.IsActive)
                        {
                            <svg viewBox="0 0 24 24" class="icon"><rect x="3" y="4" width="18" height="5" rx="1"></rect><path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"></path><path d="M10 13h4"></path></svg>
                            <span>Révoquer</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" class="icon"><path d="M3 3v5h5"></path><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"></path></svg>
                            <span>Réactiver</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>;

