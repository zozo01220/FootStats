@* Modale générique sans déclencheur propre : ouverte via @ref depuis la page (bouton "Modifier" par ex.). *@

@if (_isOpen)
{
    <div class="modal-backdrop" style="z-index: @_zIndex;" @onclick="Close">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-header-title">
                    <span class="section-title">@Label</span>
                    @if (Subtitle is not null)
                    {
                        @Subtitle
                    }
                </div>
                <button class="icon-btn" type="button" @onclick="Close" aria-label="Fermer">
                    <svg viewBox="0 0 24 24" class="icon"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="modal-body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Label { get; set; } = "Modifier";
    [Parameter] public RenderFragment? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Compteur partagé par toutes les modales : celle ouverte le plus récemment passe devant les autres,
    // même quand elle est déclarée plus tôt dans le DOM (ex. modale d'édition ouverte depuis une modale
    // de gestion — sans ça, les deux .modal-backdrop ont le même z-index et l'ordre du DOM tranche).
    private static int _zIndexCounter = 50;
    private bool _isOpen;
    private int _zIndex = 50;

    public void Open()
    {
        _isOpen = true;
        _zIndex = Interlocked.Increment(ref _zIndexCounter);
        StateHasChanged();
    }

    public void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }
}
